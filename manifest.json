{
  "manifest_version": 3,
  "name": "AutoHyperlink",
  "version": "1.0",
  "description": "Automatically adds hyperlinks to ServiceNow text",
  "icons": {
    "16": "images/icon-16.png",
    "48": "images/icon-48.png",
    "128": "images/icon-128.png"
  },
  "incognito": "split",
  "action": {
    "default_popup": "source/public/html/popup.html",
    "default_icon": {
      "16": "images/icon-16.png",
      "48": "images/icon-48.png",
      "128": "images/icon-128.png"
    }
  },
  "content_scripts": [
    {
      "js": [ "source/Defaults.js", "source/Hyperlink.js" ],
      "matches": [ "<all_urls>" ],
      "all_frames": true,
      "run_at":  "document_end"
    }
  ],
  "background": {
    "service_worker": "source/Background.js",
    "type": "module"
  },
  "permissions": [
    "tabs",
    "scripting",
    "activeTab",
    "storage"
  ],
  "host_permissions": [
    "<all_urls>"
  ]
}